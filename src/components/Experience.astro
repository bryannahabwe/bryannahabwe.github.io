---
import { experience } from "../data/experience";
---

<div id="experience" class="block" aria-labelledby="experience-title">
  <h2 id="experience-title" class="kicker">Experience</h2>
  <p class="sub">A journey of building and delivering financial and enterprise systems.</p>
  <ol class="timeline" role="list">
    {experience.map((role) => (
      <li class="role" data-reveal>
        <h3 class="title">
          {role.title} <span class="co">– {role.url ? <a href={role.url} target="_blank" rel="noopener">{role.company}</a> : role.company}</span>
        </h3>
        <p class="meta">{role.location} <span aria-hidden="true">•</span> {role.period}{role.kind && <> · {role.kind}</>}</p>
        <p class="summary">{role.summary}</p>
        {role.highlights.length > 0 && (
          <details>
            <summary>Key contributions</summary>
            <ul>
              {role.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </details>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  .sub {
    margin-top: var(--s-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .timeline {
    position: relative;
    margin-top: var(--s-5);
    padding: 0 0 0 var(--s-5);
    list-style: none;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--rule);
  }
  .role {
    position: relative;
    padding-bottom: var(--s-5);
  }
  .role::before {
    content: "";
    position: absolute;
    left: calc(var(--s-5) * -1);
    top: 0.35rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .title {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .co a {
    color: inherit;
    text-decoration: none;
  }
  .co a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .meta {
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .summary {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  details {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--accent);
    font-weight: 600;
    font-size: var(--text-xs);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    font-size: 1.1em;
    line-height: 1;
  }
  details[open] summary::after {
    content: "–";
  }
  details ul {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
    padding-left: 1.1em;
    color: var(--ink-2);
  }
  details li::marker {
    color: var(--accent);
  }
</style>
