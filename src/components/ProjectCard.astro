---
import type { Project } from "../data/projects";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const num = String(index).padStart(2, "0");
---

<article class="row">
  <span class="num">{num}</span>
  <div class="main">
    <p class="kick">{project.kicker}</p>
    <h3><a class="stretched" href={`/work/${project.slug}/`}>{project.title}</a></h3>
    <p class="summary">{project.summary}</p>
    <p class="ctx">{project.context} · {project.period}</p>
  </div>
  <span class="go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: start;
    padding: var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .row:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--rule));
  }
  .num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    padding-top: 0.15rem;
  }
  .kick {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
  }
  h3 {
    margin-top: var(--s-1);
    font-size: var(--text-lg);
    line-height: 1.25;
  }
  .stretched {
    text-decoration: none;
  }
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .stretched:focus-visible {
    outline: none;
  }
  .row:has(.stretched:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .summary {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .ctx {
    margin-top: var(--s-3);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .go {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .row:hover .go {
    background: var(--accent);
    color: var(--accent-ink);
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .num {
      display: none;
    }
  }
</style>
