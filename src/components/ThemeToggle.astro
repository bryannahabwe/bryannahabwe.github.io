<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle colour theme" aria-pressed="false">
  <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
  </svg>
  <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<style>
  /* Lives in the always-dark header. Shows the theme you'd switch to. */
  .theme-toggle {
    display: none;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border: 1px solid var(--night-rule);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.06);
    color: var(--night-ink);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  :global(.js) .theme-toggle {
    display: grid;
  }
  .theme-toggle:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .sun {
    display: none;
  }
  .theme-toggle[aria-pressed="true"] .moon {
    display: none;
  }
  .theme-toggle[aria-pressed="true"] .sun {
    display: block;
  }
</style>
