---
/**
 * Inline SVG icons. Line icons are drawn on a 24px grid with currentColor
 * strokes; brand marks come from simple-icons and use their brand colour
 * unless `mono` is set.
 */
import { siPython, siApachekafka, siReact, siPostgresql, siGithub } from "simple-icons";
// Official multi-colour marks that simple-icons lacks (Devicon, MIT — see src/assets/logos/README.md).
import javaSvg from "../assets/logos/java.svg?raw";
import springSvg from "../assets/logos/spring.svg?raw";

const line = {
  rocket: [
    "M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z",
    "m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z",
    "M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0",
    "M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5",
  ],
  layers: [
    "M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z",
    "m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65",
    "m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65",
  ],
  bulb: [
    "M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5",
    "M9 18h6",
    "M10 22h4",
  ],
  trend: ["M22 7l-8.5 8.5-5-5L2 17", "M16 7h6v6"],
  shield: [
    "M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z",
    "m9 12 2 2 4-4",
  ],
  bolt: [
    "M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z",
  ],
  lock: ["M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z", "M7 11V7a5 5 0 0 1 10 0v4"],
  wrench: [
    "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z",
  ],
  server: [
    "M4 2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z",
    "M4 14h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2z",
    "M6 6h.01",
    "M6 18h.01",
  ],
  database: ["M21 5c0 1.66-4 3-9 3S3 6.66 3 5s4-3 9-3 9 1.34 9 3z", "M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5", "M3 12c0 1.66 4 3 9 3s9-1.34 9-3"],
  stream: ["M12 5a2 2 0 1 0 0-.01", "M5 12a2 2 0 1 0 0-.01", "M19 12a2 2 0 1 0 0-.01", "M12 19a2 2 0 1 0 0-.01", "M10.6 6.4 6.4 10.6", "M13.4 6.4l4.2 4.2", "M6.4 13.4l4.2 4.2", "M17.6 13.4l-4.2 4.2"],
  cloud: ["M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"],
  code: ["m16 18 6-6-6-6", "m8 6-6 6 6 6"],
  network: [
    "M17 16h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z",
    "M3 16h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z",
    "M10 2h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z",
    "M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3",
    "M12 12V8",
  ],
  arrow: ["M5 12h14", "m12 5 7 7-7 7"],
  arrowUpRight: ["M7 7h10v10", "M7 17 17 7"],
  mail: ["M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z", "m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"],
  briefcase: ["M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16", "M4 6h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"],
  pin: ["M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0", "M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"],
} as const;

const logos = { java: javaSvg, spring: springSvg } as const;

const brands = {
  python: siPython,
  kafka: siApachekafka,
  react: siReact,
  postgres: siPostgresql,
  github: siGithub,
} as const;

export type LineIcon = keyof typeof line;
export type BrandIcon = keyof typeof brands | keyof typeof logos | "linkedin";

interface Props {
  name: LineIcon | BrandIcon;
  size?: number;
  mono?: boolean;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, mono = false, class: className, strokeWidth = 1.75 } = Astro.props;
const brand = name in brands ? brands[name as keyof typeof brands] : undefined;
const logo =
  name in logos
    ? logos[name as keyof typeof logos].replace(
        "<svg ",
        `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ""} `
      )
    : undefined;
// Brand colours that would vanish on dark surfaces fall back to currentColor.
const brandFill = brand && !mono && !["000000", "231F20", "181717"].includes(brand.hex) ? `#${brand.hex}` : "currentColor";
---

{logo ? (
  <Fragment set:html={logo} />
) : name === "linkedin" ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="24" rx="4" fill={mono ? "currentColor" : "#0A66C2"} />
    <path fill={mono ? "var(--night, #fff)" : "#fff"} d="M7.1 9.6h-2.6V19h2.6V9.6zM5.8 5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm13.7 8.6c0-2.6-1.4-4.2-3.6-4.2-1.3 0-2.2.7-2.6 1.4V9.6h-2.5V19h2.6v-4.9c0-1.3.6-2.2 1.7-2.2 1.1 0 1.6.8 1.6 2.2V19h2.8v-5.4z" />
  </svg>
) : brand ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill={brandFill} d={brand.path} />
  </svg>
) : (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {line[name as LineIcon].map((d) => <path d={d} />)}
  </svg>
)}
