---
/** Illustrated card headers — drawn, not stock photography. */
interface Props {
  variant: "investing" | "mobile-money" | "school";
}
const { variant } = Astro.props;
---

<svg class="art" viewBox="0 0 400 150" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`bg-${variant}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#071226" />
      <stop offset="1" stop-color="#0f2c5e" />
    </linearGradient>
    <radialGradient id={`glow-${variant}`} cx="0.75" cy="0.2" r="0.7">
      <stop offset="0" stop-color="#3b82f6" stop-opacity="0.45" />
      <stop offset="1" stop-color="#3b82f6" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="400" height="150" fill={`url(#bg-${variant})`} />
  <rect width="400" height="150" fill={`url(#glow-${variant})`} />
  <g stroke="#ffffff" stroke-opacity="0.06">
    {Array.from({ length: 9 }, (_, i) => <line x1={i * 50} y1="0" x2={i * 50} y2="150" />)}
    {Array.from({ length: 4 }, (_, i) => <line x1="0" y1={i * 50} x2="400" y2={i * 50} />)}
  </g>

  {variant === "investing" && (
    <g>
      {[30, 46, 38, 58, 52, 72, 66, 86, 80, 100].map((h, i) => (
        <rect x={40 + i * 24} y={130 - h} width="12" height={h} rx="2" fill="#3b82f6" fill-opacity={0.25 + i * 0.05} />
      ))}
      <path d="M40 112 L88 96 L136 102 L184 78 L232 84 L280 56 L318 40" fill="none" stroke="#60a5fa" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M306 36 L322 38 L318 54" fill="none" stroke="#60a5fa" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      {[0, 1, 2, 3].map((i) => <ellipse cx="350" cy={128 - i * 9} rx="22" ry="6" fill="#f5b942" stroke="#b7791f" stroke-width="1" />)}
      <circle cx="350" cy="72" r="16" fill="none" stroke="#f5b942" stroke-width="2" />
      <text x="350" y="78" text-anchor="middle" font-family="DM Sans Variable, sans-serif" font-size="16" font-weight="700" fill="#f5b942">↑</text>
    </g>
  )}

  {variant === "mobile-money" && (
    <g>
      <rect x="160" y="18" width="80" height="150" rx="14" fill="#0b1526" stroke="#93b4f5" stroke-opacity="0.6" stroke-width="2" />
      <rect x="168" y="32" width="64" height="120" rx="6" fill="#123063" />
      <text x="176" y="52" font-family="DM Sans Variable, sans-serif" font-size="8" fill="#93b4f5">Balance</text>
      <text x="176" y="68" font-family="DM Sans Variable, sans-serif" font-size="13" font-weight="700" fill="#ffffff">UGX ••••</text>
      <rect x="176" y="80" width="48" height="10" rx="5" fill="#3b82f6" />
      <rect x="176" y="98" width="40" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.35" />
      <rect x="176" y="110" width="30" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.25" />
      <rect x="176" y="122" width="44" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.25" />
      {[18, 32, 46].map((r) => <path d={`M${250 + r * 0.2} ${70 - r * 0.6} a${r} ${r} 0 0 1 0 ${r * 1.2}`} fill="none" stroke="#60a5fa" stroke-opacity="0.7" stroke-width="2.5" stroke-linecap="round" />)}
      <g font-family="DM Sans Variable, sans-serif" font-size="10" font-weight="700">
        <rect x="40" y="44" width="78" height="26" rx="13" fill="#ffcc00" />
        <text x="79" y="61" text-anchor="middle" fill="#0b1526">MTN MoMo</text>
        <rect x="40" y="82" width="78" height="26" rx="13" fill="#e4002b" />
        <text x="79" y="99" text-anchor="middle" fill="#ffffff">Airtel Money</text>
      </g>
      <path d="M122 57 H156 M122 95 H156" stroke="#93b4f5" stroke-opacity="0.6" stroke-width="1.5" stroke-dasharray="3 4" />
    </g>
  )}

  {variant === "school" && (
    <g>
      {[0, 1, 2, 3].map((c) =>
        [0, 1].map((r) => (
          <g transform={`translate(${44 + c * 82} ${30 + r * 58})`}>
            <rect width="66" height="44" rx="6" fill="#123063" stroke="#93b4f5" stroke-opacity={c === 1 && r === 0 ? 0.9 : 0.3} stroke-width="1.5" />
            <path d="M14 26 L33 14 L52 26" fill="none" stroke="#60a5fa" stroke-width="2" stroke-linejoin="round" />
            <rect x="20" y="26" width="26" height="10" fill="none" stroke="#60a5fa" stroke-width="2" />
            <text x="6" y="12" font-family="ui-monospace, monospace" font-size="6" fill="#93b4f5">{`school_${r * 4 + c + 1}`}</text>
          </g>
        ))
      )}
    </g>
  )}
</svg>

<style>
  .art {
    width: 100%;
    height: 100%;
  }
</style>
