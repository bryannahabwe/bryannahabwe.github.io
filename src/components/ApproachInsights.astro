---
import Icon from "./Icon.astro";
import { pillarsOfApproach, writing } from "../data/expertise";

const latest = writing[0];
---

<section class="section" aria-label="Engineering approach and insights">
  <div class="container grid">
    <div id="approach" class="block">
      <h2 class="kicker">Engineering Approach</h2>
      <p class="sub">I focus on building maintainable, scalable and secure systems.</p>
      <ul class="pillars" role="list">
        {pillarsOfApproach.map((p, i) => (
          <li data-reveal style={`transition-delay: ${i * 50}ms`}>
            <span class="icon"><Icon name={p.icon} size={30} strokeWidth={1.6} /></span>
            <strong>{p.title}</strong>
            <span class="body">{p.body}</span>
          </li>
        ))}
      </ul>
    </div>

    <div id="insights" class="block">
      <h2 class="kicker">Latest Insights</h2>
      <p class="sub">Sharing knowledge, lessons and engineering thoughts.</p>
      <article class="card insight" data-reveal>
        <div class="thumb" aria-hidden="true">
          <pre><code><span class="k">public interface</span> <span class="t">NotificationProvider</span> {"{"}
  <span class="t">String</span> channel();
  <span class="t">DeliveryResult</span> send(<span class="t">Message</span> m);
{"}"}

<span class="c">// META-INF/services → ServiceLoader</span>
<span class="k">for</span> (<span class="k">var</span> f : <span class="t">ServiceLoader</span>
    .load(<span class="t">ProviderFactory</span>.<span class="k">class</span>))</code></pre>
        </div>
        <div class="meta">
          <h3>{latest.href ? <a href={latest.href}>{latest.title}</a> : latest.title}</h3>
          <p>{latest.summary}</p>
          {latest.href ? (
            <a class="badge read" href={latest.href}>Read the article →</a>
          ) : (
            <span class="badge">In draft — publishing soon</span>
          )}
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--s-6) var(--section-y);
  }
  .grid {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--s-7);
    }
    #insights {
      padding-left: var(--s-7);
      border-left: 1px solid var(--rule);
    }
  }
  .sub {
    margin-top: var(--s-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 6.25rem), 1fr));
    margin-top: var(--s-5);
    padding: 0;
    list-style: none;
  }
  .pillars li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-2);
    text-align: center;
  }
  .pillars li + li {
    border-left: 1px solid var(--rule);
  }
  .icon {
    color: var(--accent);
  }
  .pillars strong {
    font-size: var(--text-sm);
    font-weight: 650;
  }
  .pillars .body {
    font-size: var(--text-xs);
    color: var(--ink-3);
    line-height: 1.45;
  }
  .insight {
    display: grid;
    margin-top: var(--s-5);
    overflow: hidden;
  }
  @media (min-width: 560px) {
    .insight {
      grid-template-columns: 13rem 1fr;
    }
  }
  .thumb {
    background: #0b1220;
    padding: var(--s-4);
    overflow: hidden;
  }
  .thumb pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.6;
    color: #c9d4e5;
    white-space: pre;
  }
  .thumb .k {
    color: #ff7aa8;
  }
  .thumb .t {
    color: #7fd3ff;
  }
  .thumb .c {
    color: #6b7a90;
  }
  .meta {
    padding: var(--s-5);
  }
  .badge.read {
    text-decoration: none;
  }
  .badge.read:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .meta h3 a {
    text-decoration: none;
  }
  .meta h3 a:hover {
    color: var(--accent);
  }
  .meta h3 {
    font-size: var(--text-md);
    line-height: 1.3;
  }
  .meta p {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .badge {
    display: inline-block;
    margin-top: var(--s-4);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .pillars li + li {
      border-left: 0;
    }
  }
</style>
